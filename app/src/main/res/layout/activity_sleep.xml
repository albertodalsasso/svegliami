<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Storico del sonno"
        app:titleTextColor="@color/on_surface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvNight"
                style="@style/Svegliami.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvNightRange"
                style="@style/Svegliami.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/scoreCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/scoreProgress"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:indicatorColor="@color/tertiary"
                            app:indicatorSize="76dp"
                            app:trackColor="@color/outline"
                            app:trackThickness="5dp" />

                        <TextView
                            android:id="@+id/tvScore"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/on_surface"
                            android:textSize="24sp"
                            android:fontFamily="sans-serif-medium" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Svegliami.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SLEEP SCORE · INDICATIVO" />

                        <TextView
                            android:id="@+id/tvScoreExplanation"
                            style="@style/Svegliami.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Numeri principali -->
            <LinearLayout
                android:id="@+id/statsBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include android:id="@+id/statSleep" layout="@layout/item_stat"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="6dp" />

                    <include android:id="@+id/statDeep" layout="@layout/item_stat"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include android:id="@+id/statWake" layout="@layout/item_stat"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="6dp" />

                    <include android:id="@+id/statSnore" layout="@layout/item_stat"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Grafico -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/graphCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <it.svegliami.SleepGraphView
                        android:id="@+id/graph"
                        android:layout_width="match_parent"
                        android:layout_height="190dp" />

                    <TextView
                        android:id="@+id/tvLegend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDetails"
                style="@style/Svegliami.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/Svegliami.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Notti registrate" />

            <LinearLayout
                android:id="@+id/nightList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Svegliami.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Le fasi sono stimate dai movimenti e dai suoni registrati dal telefono: sono un'indicazione, non una misura clinica."
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
