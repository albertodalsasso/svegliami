<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Impostazioni"
        app:titleTextColor="@color/on_surface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp">

            <TextView style="@style/Svegliami.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MONITORAGGIO DEL SONNO" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Posizione del telefono" android:textColor="@color/on_surface" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Scegli il sensore principale per le prossime sessioni." style="@style/Svegliami.Body" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/settingsSleepMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <Button android:id="@+id/settingsModeNightstand" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Comodino" />
                        <Button android:id="@+id/settingsModeMattress" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Materasso" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <TextView android:id="@+id/tvTrackingDescription" style="@style/Svegliami.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Svegliami.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="METEO E LOCALITÀ" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/tvSettingsLocation" style="@style/Svegliami.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btnOpenLocationSettings" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Gestisci località e aggiornamento GPS" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Svegliami.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="PRIVACY" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="24dp">
                <TextView style="@style/Svegliami.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="Le sessioni e il diario sono memorizzati sul dispositivo. L'app non carica registrazioni audio. La classificazione audio e la cifratura dei file non sono ancora implementate." />
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Svegliami.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="ACCOUNT E APP" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Account facoltativo" android:textColor="@color/on_surface" android:textSize="17sp" android:textStyle="bold" />
                    <TextView style="@style/Svegliami.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Accesso e sincronizzazione non sono ancora disponibili. Svegliami continua a funzionare localmente." />
                    <TextView android:id="@+id/tvSettingsVersion" style="@style/Svegliami.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/surface"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />
</LinearLayout>
